# ==============================================================================
# SECURE PERSONAL GEMINI JOURNAL - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================

# Google Cloud Project & Secret Manager Configuration
GCP_PROJECT_ID=your-gcp-project-id
GEMINI_SECRET_NAME=gemini-api-key
GEMINI_SECRET_VERSION=latest

# Local Development Fallback (If not using GCP Secret Manager locally)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration (Server-Side)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: Path or stringified JSON of Service Account credentials
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Server Config
PORT=5000
NODE_ENV=development
